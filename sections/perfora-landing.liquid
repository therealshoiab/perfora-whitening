{% comment %}
  =============================================================================
  PERFORA PURPLE WHITENING STORE — MAIN LANDING SECTION
  Clean Online Store 2.0 section with external assets (under 256 KB limit)
  =============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'perfora-store.css' | asset_url }}">

<script>
// Dynamic Shopify Product Variant Mapping
window.SHOPIFY_VARIANTS = {
  0: "{{ all_products['perfora-purple-whitening-toothpaste'].selected_or_first_available_variant.id | default: '' }}",
  1: "{{ all_products['perfora-activated-charcoal-whitening-toothpaste'].selected_or_first_available_variant.id | default: '' }}",
  2: "{{ all_products['perfora-teeth-whitening-combo'].selected_or_first_available_variant.id | default: '' }}",
  3: "{{ all_products['perfora-teeth-whitening-strips'].selected_or_first_available_variant.id | default: '' }}",
  4: "{{ all_products['perfora-purple-teeth-whitening-strips'].selected_or_first_available_variant.id | default: '' }}",
  5: "{{ all_products['perfora-purple-teeth-whitening-toothpaste-serum'].selected_or_first_available_variant.id | default: '' }}"
};
window.SHOPIFY_STORE_DOMAIN = "{{ shop.permanent_domain | default: shop.domain }}";
</script>

<div class="perfora-landing-container">
<header><div class="wrap"><a class="logo" href="#top">perfora</a><span><a class="navl" href="#shop">Shop all</a><button class="cartbtn" id="open">Cart (<span id="cnt">0</span>)</button></span></div></header>
<main id="top">
<div class="hero"><div class="wrap">
<div><h1>Brush purple.<span>Smile brighter.</span></h1>
<p>Perfora Purple Whitening Toothpaste, Grape Mint. A fluoride toothpaste made to lift yellow stains when you brush twice a day.</p>
<a class="btn" href="#buy">Buy now</a>
<div class="pills"><i>Fluoride+</i><i>Enamel safe</i><i>SLS free</i><i>75 g</i></div></div>
<div class="stage"><img data-i="0" alt="Perfora Purple Whitening Toothpaste tube with grapes"></div>
</div></div>

<section id="buy"><div class="wrap buy">
<div class="gal"><div class="main"><img id="big" data-i="18" alt="Product view"></div>
<div class="thumbs" id="th"></div></div>
<div><h2>Perfora Purple Whitening Toothpaste, 75 g</h2>
<div class="price"><b>₹399</b></div>
<p class="fine">Inclusive of taxes. Free delivery across India. Delivery in 7-10 days.</p>
<div class="row"><div class="qty"><button aria-label="Decrease" id="m">−</button><span id="q">1</span><button aria-label="Increase" id="p">+</button></div>
<button class="btn dark" id="add">Add to cart</button></div>
<ul><li>Teeth whitening and stain remover, enamel safe</li><li>Grape Mint flavour</li><li>Free from SLS, titanium dioxide and sodium saccharin</li></ul>
<p class="fine">The instant whitening look from purple toothpaste is temporary. For lasting stain removal, brush daily.</p></div>
</div></section>

<section style="padding-top:0"><div class="wrap"><h2>Two minutes, twice a day</h2>
<p class="lead">Use it like any toothpaste, then keep it up. Stain removal builds with daily use.</p>
<div class="steps"><div><h3>Squeeze</h3><p>A pea-sized amount on a soft brush.</p></div><div><h3>Brush for 2 minutes</h3><p>Morning and night, covering every tooth.</p></div><div><h3>Rinse and smile</h3><p>Repeat daily to see a visible change in stains.</p></div></div></div></section>

<section class="proof"><div class="wrap"><h2>What daily use looks like</h2>
<p class="lead">Images from the brand's own listing. Results vary from person to person.</p>
<div class="grid"><figure><img data-i="1" alt="Day 0, 7, 15 and 30 progress"><figcaption>Brand-shown progress over 30 days of brushing twice daily.</figcaption></figure>
<figure><img data-i="2" alt="Before, during and after purple toothpaste"><figcaption>The purple tint colour-corrects yellow tones. The instant effect is temporary.</figcaption></figure></div></div></section>

<section><div class="wrap free"><img data-i="3" alt="SLS free, titanium dioxide free, sodium saccharin free">
<div><h2>What it leaves out</h2><p class="lead">No SLS, no titanium dioxide, and no sodium saccharin (artificial sweetener). Fluoride stays in for cavity protection.</p><a class="btn dark" href="#buy">Get yours</a></div></div></section>

<section id="shop"><div class="wrap"><h2>Shop all</h2><p class="lead">Whitening toothpaste, strips, a serum and a brush combo. Free delivery on every order.</p><div class="grid" id="grid"></div></div></section>
<section style="padding-top:0"><div class="wrap"><h2>Questions</h2>
<details><summary>Is it safe for enamel?</summary><p>It is made as an enamel safe whitening toothpaste. If you have sensitive teeth or a dental condition, check with your dentist first.</p></details>
<details><summary>How soon will I see a change?</summary><p>The purple tint can make teeth look brighter right after brushing, but that is temporary. Lasting results need daily brushing for a few weeks.</p></details>
<details><summary>How long does delivery take?</summary><p>Usually 7-10 days across India.</p></details>
<details><summary>Can I return it?</summary><p>If your parcel arrives damaged or wrong, message us with a photo and we will sort out a replacement or refund.</p></details></div></section>
<section class="band" id="why"><h2 id="gh"></h2><div class="rail"><div class="trk" id="gt"></div></div></section>
</main>
<footer><div class="wrap">Questions about an order? <a href="https://wa.me/919419600518">Message us on WhatsApp</a></div></footer>

<div id="veil"></div>
<aside id="drawer" aria-label="Cart"><button class="x" id="close" aria-label="Close cart">×</button>
<h2>Your cart</h2><div id="cartbody"></div></aside>

<div id="pm" role="dialog" aria-label="Product details"></div>
</div>

<script src="{{ 'perfora-store.js' | asset_url }}" defer></script>

